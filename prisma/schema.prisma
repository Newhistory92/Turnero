
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}


model Turno {
  id             Int            @id @default(autoincrement())
  numero         String   
  servicio       String
  departamento   String
  estado         String   @default("esperando")
  timestamp      DateTime @default(now())
  boxAsignado    String?  // Se actualiza cuando se llama
  tiempoLlamado  DateTime?
  tiempoAtencion Int?     // Se actualiza al finalizar la atención
}
